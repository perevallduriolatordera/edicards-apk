<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_marginBottom="8dp"
    android:elevation="2dp">

    <!-- Fila principal: Botones reorden + Orden + Info básica + Distancia -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Botones para reordenar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <Button
                android:id="@+id/btnMoverArriba"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:text="↑"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="#607D8B"
                android:textColor="@android:color/white"
                android:padding="0dp"
                android:layout_marginBottom="2dp"/>

            <Button
                android:id="@+id/btnMoverAbajo"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:text="↓"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="#607D8B"
                android:textColor="@android:color/white"
                android:padding="0dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtOrden"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:text="1"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#1976D2"
            android:textColor="@android:color/white"
            android:layout_marginEnd="14dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del Cliente"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/txtDireccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calle Ejemplo, 123"
                android:textSize="12sp"
                android:textColor="#424242"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/txtPoblacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Barcelona, Barcelona"
                android:textSize="12sp"
                android:textColor="#424242"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/txtZona"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zona Centro"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:background="#2196F3"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:visibility="gone"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/txtUltimaVisita"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Última visita: 15 días (12/12/2024)"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:background="#4CAF50"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:visibility="visible"
                android:layout_marginBottom="4dp"/>

            <!-- Coordenadas en línea compacta -->
            <TextView
                android:id="@+id/txtCoordenadas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 40.4168, -3.7038"
                android:textSize="9sp"
                android:textColor="#757575"
                android:fontFamily="monospace"
                android:visibility="gone"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Distancia"
                android:textSize="10sp"
                android:textColor="#757575"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/txtDistancia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25 km"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FF6F00"/>
        </LinearLayout>

        <!-- Botón favorito -->
        <Button
            android:id="@+id/btnFavorito"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="☆"
            android:textSize="24sp"
            android:background="#FFFFFF"
            android:textColor="#FFC107"
            android:layout_marginStart="8dp"
            android:padding="0dp"/>

    </LinearLayout>

</LinearLayout>
