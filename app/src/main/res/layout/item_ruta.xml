<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_marginBottom="8dp"
    android:elevation="2dp">

    <!-- Fila principal: Orden + Info básica + Distancia -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtOrden"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:text="1"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#1976D2"
            android:textColor="@android:color/white"
            android:layout_marginEnd="14dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del Cliente"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/txtDireccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calle Ejemplo, 123"
                android:textSize="12sp"
                android:textColor="#424242"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/txtPoblacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Barcelona, Barcelona"
                android:textSize="12sp"
                android:textColor="#424242"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/txtZona"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zona Centro"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:background="#2196F3"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:visibility="gone"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Distancia"
                android:textSize="10sp"
                android:textColor="#757575"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/txtDistancia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25 km"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FF6F00"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Información adicional: Coordenadas (expandible) -->
    <LinearLayout
        android:id="@+id/layoutCoordenadas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:background="#F5F5F5"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Latitud:"
                android:textSize="11sp"
                android:textColor="#757575"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtLatitud"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="40.4168"
                android:textSize="11sp"
                android:textColor="#1A1A1A"
                android:gravity="end"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Longitud:"
                android:textSize="11sp"
                android:textColor="#757575"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtLongitud"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="-3.7038"
                android:textSize="11sp"
                android:textColor="#1A1A1A"
                android:gravity="end"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
