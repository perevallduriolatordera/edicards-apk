<?xml version="1.0" encoding="utf-8"?>
<!-- Layout compacto: TODA la info en UNA SOLA FILA -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#FFFFFF"
    android:paddingLeft="4dp"
    android:paddingRight="4dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:layout_marginBottom="1dp"
    android:gravity="center_vertical">

    <!-- Botones reorden compactos -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="3dp">

        <Button
            android:id="@+id/btnMoverArriba"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:text="↑"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#607D8B"
            android:textColor="@android:color/white"
            android:padding="0dp"
            android:layout_marginBottom="1dp"/>

        <Button
            android:id="@+id/btnMoverAbajo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:text="↓"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#607D8B"
            android:textColor="@android:color/white"
            android:padding="0dp"/>
    </LinearLayout>

    <!-- Número de orden -->
    <TextView
        android:id="@+id/txtOrden"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:text="1"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#1976D2"
        android:textColor="@android:color/white"
        android:layout_marginEnd="6dp"/>

    <!-- Nombre del cliente (reducido) -->
    <TextView
        android:id="@+id/txtNombre"
        android:layout_width="0dp"
        android:layout_weight="2"
        android:layout_height="wrap_content"
        android:text="Nombre Cliente"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginEnd="4dp"/>

    <!-- Dirección (reducido) -->
    <TextView
        android:id="@+id/txtDireccion"
        android:layout_width="0dp"
        android:layout_weight="1.5"
        android:layout_height="wrap_content"
        android:text="C/ Ejemplo, 123"
        android:textSize="9sp"
        android:textColor="#424242"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginEnd="4dp"/>

    <TextView
        android:id="@+id/txtPoblacion"
        android:layout_width="0dp"
        android:layout_weight="1.2"
        android:layout_height="wrap_content"
        android:text="Barcelona"
        android:textSize="9sp"
        android:textColor="#424242"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginEnd="4dp"/>

    <!-- Última visita (reducido) -->
    <TextView
        android:id="@+id/txtUltimaVisita"
        android:layout_width="0dp"
        android:layout_weight="0.9"
        android:layout_height="wrap_content"
        android:text="15d"
        android:textSize="8sp"
        android:textColor="#FFFFFF"
        android:background="#4CAF50"
        android:gravity="center"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:maxLines="1"
        android:layout_marginEnd="4dp"/>

    <!-- Distancia (reducido) -->
    <TextView
        android:id="@+id/txtDistancia"
        android:layout_width="0dp"
        android:layout_weight="0.6"
        android:layout_height="wrap_content"
        android:text="25km"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#FF6F00"
        android:gravity="center"
        android:maxLines="1"
        android:layout_marginEnd="4dp"/>

    <!-- Botón favorito (más pequeño) -->
    <Button
        android:id="@+id/btnFavorito"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:text="☆"
        android:textSize="16sp"
        android:background="#FFFFFF"
        android:textColor="#FFC107"
        android:layout_marginEnd="2dp"
        android:padding="0dp"/>

    <!-- Botón Ver Ficha (más pequeño) -->
    <Button
        android:id="@+id/btnVerFicha"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:text="📋"
        android:textSize="12sp"
        android:background="#03A9F4"
        android:textColor="#FFFFFF"
        android:padding="0dp"/>

    <!-- Elementos ocultos pero necesarios para el código -->
    <TextView
        android:id="@+id/txtZona"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/txtClienteNuevo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/txtCoordenadas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

</LinearLayout>
