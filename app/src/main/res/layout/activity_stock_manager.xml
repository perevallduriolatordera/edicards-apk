<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/mainLayoutStockManager"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
	android:orientation="vertical"
    android:background="@color/Edicards"> >

	<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
		android:id="@+id/headerStockButtonsLinearLayout"
		android:layout_width="fill_parent"
		android:layout_height="50px"
		android:layout_marginTop="5dp"
		android:background="@color/WhiteSmoke"
		android:orientation="horizontal" >

	</LinearLayout>

	<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        	  android:id="@+id/headerMainLinearLayout" 
              android:layout_width="fill_parent" 
              android:layout_height="50px" 
              android:layout_marginTop="5dp"
              android:background="@color/DarkBlue"
              android:orientation="horizontal" >
              
        <TextView
        	android:text="Código"
			android:layout_weight="1"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
    		android:textSize="16dp"
    		android:layout_marginTop="10dp"
    		android:layout_marginLeft="20dp"/>
        
        <TextView
        	android:text="Artículo"
			android:layout_weight="4"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
    		android:textSize="16dp"
    		android:layout_marginTop="10dp" />
        
        <TextView
        	android:text="Actual"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:textSize="16dp"
    		android:layout_marginTop="10dp" />
            

        <TextView
        	android:text="Reciclado"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:textSize="16dp"
    		android:layout_marginTop="10dp" />
        
        <TextView
        	android:text="Recuento"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:textSize="16dp"
    		android:layout_marginTop="10dp" />

		<TextView
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:textSize="16dp"/>


	</LinearLayout>
 
	<LinearLayout  xmlns:android="http://schemas.android.com/apk/res/android"
		android:orientation="vertical"
		android:layout_width="fill_parent"
	    android:layout_height="fill_parent"
		android:background="@color/White">
		<ListView
			android:id="@+id/listViewArticles"
			android:layout_width="fill_parent"
			android:layout_height="match_parent"
			android:divider="#b5b5b5"
			android:dividerHeight="1dp"/>
    </LinearLayout>
</LinearLayout>
