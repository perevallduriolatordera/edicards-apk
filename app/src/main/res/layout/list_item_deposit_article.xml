<?xml version="1.0" encoding="utf-8"?>
<!-- Layout compacto: TODA la info en UNA SOLA FILA -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#FFFFFF"
    android:paddingLeft="4dp"
    android:paddingRight="4dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:layout_marginBottom="1dp"
    android:gravity="center_vertical">

    <!-- Código del artículo - ancho similar al header "Código" (13) -->
    <TextView
        android:id="@+id/itemCodigoArticulo"
        android:layout_width="0dp"
        android:layout_weight="0.9"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#1976D2"
        android:background="#E3F2FD"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:gravity="center"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="2dp"/>

    <!-- Descripción del artículo - ancho similar al header "Artículo" (12) -->
    <TextView
        android:id="@+id/itemDescripcionArticulo"
        android:layout_width="0dp"
        android:layout_weight="2.2"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="left"
        android:layout_marginRight="2dp"/>

    <!-- Dep. Inicial - ancho similar al header (13) -->
    <TextView
        android:id="@+id/itemUnidadesInicial"
        android:layout_width="0dp"
        android:layout_weight="0.9"
        android:layout_height="wrap_content"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="#424242"
        android:gravity="center"
        android:layout_marginRight="2dp"/>

    <!-- Contadas - ancho similar al header (13) -->
    <TextView
        android:id="@+id/itemUnidadesContadas"
        android:layout_width="0dp"
        android:layout_weight="0.9"
        android:layout_height="wrap_content"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="#424242"
        android:gravity="center"
        android:layout_marginRight="2dp"/>

    <!-- Recicladas - ancho similar al header (13) -->
    <TextView
        android:id="@+id/itemUnidadesRecicladas"
        android:layout_width="0dp"
        android:layout_weight="0.9"
        android:layout_height="wrap_content"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="#424242"
        android:gravity="center"
        android:layout_marginRight="2dp"/>

    <!-- PVP - ancho similar al header (13) -->
    <TextView
        android:id="@+id/itemPVP"
        android:layout_width="0dp"
        android:layout_weight="0.9"
        android:layout_height="wrap_content"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="#4CAF50"
        android:gravity="center"
        android:layout_marginRight="2dp"/>

    <!-- Facturadas - ancho similar al header (13) -->
    <TextView
        android:id="@+id/itemUnidadesFacturadas"
        android:layout_width="0dp"
        android:layout_weight="0.9"
        android:layout_height="wrap_content"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="#424242"
        android:gravity="center"
        android:layout_marginRight="2dp"/>

    <!-- Repuestas - ancho similar al header (13) -->
    <TextView
        android:id="@+id/itemUnidadesRepuestas"
        android:layout_width="0dp"
        android:layout_weight="0.9"
        android:layout_height="wrap_content"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="#424242"
        android:gravity="center"
        android:layout_marginRight="2dp"/>

    <!-- PVP Post - ancho similar al header (13) -->
    <TextView
        android:id="@+id/itemPVPPost"
        android:layout_width="0dp"
        android:layout_weight="0.9"
        android:layout_height="wrap_content"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="#4CAF50"
        android:gravity="center"
        android:layout_marginRight="2dp"/>

    <!-- Total - placeholder oculto para mantener estructura -->
    <View
        android:layout_width="0dp"
        android:layout_weight="0.9"
        android:layout_height="1dp"
        android:layout_marginRight="2dp"
        android:visibility="invisible"/>

    <!-- Icono del artículo - equivale aproximadamente al espacio del botón abono -->
    <ImageView
        android:id="@+id/itemImage"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="0dp"
        android:contentDescription="Icono del artículo"/>

</LinearLayout>
