<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reportsManagerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!-- Cabecera Compacta -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#E8F5E9"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="center">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Informes y Reportes"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Botones de Acción -->
    <LinearLayout
        android:id="@+id/headerReportButtonsLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        android:background="#F5F5F5"
        android:padding="8dp"/>

    <!-- Selectores de Fecha -->
    <LinearLayout
        android:id="@+id/datePickersContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FAFAFA"
        android:padding="6dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rango de Fechas"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginBottom="4dp"/>
    </LinearLayout>

    <!-- Área de Resultados -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Resultados"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#424242"
        android:layout_marginBottom="4dp"/>

    <ScrollView
        android:id="@+id/svcScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FAFAFA"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/mainLinearLayoutArticles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"/>
    </ScrollView>

</LinearLayout>
