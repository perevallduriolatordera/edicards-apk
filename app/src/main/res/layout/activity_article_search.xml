<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!-- Cabecera Moderna -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFF3E0"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:gravity="center">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Búsqueda de Artículos"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#E65100"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Campo de Búsqueda -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FAFAFA"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/lblSearchArticle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textSize="14sp"
            android:textColor="#424242"
            android:text="Artículo:" />

        <AutoCompleteTextView
            android:id="@+id/myautocompleteArticle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#212121"
            android:hint="Buscar por descripción"
            android:padding="8dp"
            android:background="@android:drawable/edit_text"
            android:completionThreshold="1"/>
    </LinearLayout>

    <!-- ScrollView para información del artículo -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Información Básica -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F5F5F5"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Información Básica"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#E65100"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/lblIdArticuloLabel"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#616161"
                        android:text="Código:" />

                    <TextView
                        android:id="@+id/lblIdArticulo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:textColor="#212121"
                        android:textStyle="bold"
                        android:text="" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/lblDescripcionArticuloLabel"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#616161"
                        android:text="Descripción:" />

                    <TextView
                        android:id="@+id/lblDescripcionArticulo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:textColor="#212121"
                        android:textStyle="bold"
                        android:text="" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/lblFamiliaArticuloLabel"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#616161"
                        android:text="Familia:" />

                    <TextView
                        android:id="@+id/lblFamiliaArticulo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:textColor="#212121"
                        android:textStyle="bold"
                        android:text="" />
                </LinearLayout>
            </LinearLayout>

            <!-- Información Comercial -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F5F5F5"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Información Comercial"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#E65100"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/lblPrecioArticuloLabel"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#616161"
                        android:text="Precio:" />

                    <TextView
                        android:id="@+id/lblPrecioArticulo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:textColor="#212121"
                        android:textStyle="bold"
                        android:text="" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/lblTipoIVAArticuloLabel"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#616161"
                        android:text="Tipo IVA:" />

                    <TextView
                        android:id="@+id/lblTipoIVAArticulo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:textColor="#212121"
                        android:textStyle="bold"
                        android:text="" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/lblDescuento1ArticuloLabel"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#616161"
                        android:text="Descuento 1:" />

                    <TextView
                        android:id="@+id/lblDescuento1Articulo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:textColor="#212121"
                        android:textStyle="bold"
                        android:text="" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/lblDescuento2ArticuloLabel"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#616161"
                        android:text="Descuento 2:" />

                    <TextView
                        android:id="@+id/lblDescuento2Articulo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:textColor="#212121"
                        android:textStyle="bold"
                        android:text="" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
