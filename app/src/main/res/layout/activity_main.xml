<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent"
              android:orientation="vertical"
              android:background="@color/Edicards" >

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/edicards_logo_bitmap"
        android:layout_gravity="center"
        android:layout_marginTop="10px"
        android:layout_marginBottom="100px"
    />

   <TextView android:id="@+id/lblUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="250px"
        android:layout_marginRight="250px"
        android:layout_marginTop="15px"
       android:textSize="24sp"
        android:textColor="#FFF"
        android:text="Identificador del usuario" />

    <EditText
        android:id="@+id/txtUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="250px"
        android:layout_marginRight="250px"
        android:textSize="24sp"
        android:ems="10" >

        <requestFocus />
    </EditText>

    <TextView android:id="@+id/lblPassword"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginLeft="250px"
        	  android:layout_marginRight="250px"
        	  android:textColor="#FFF"
              android:textSize="24sp"
              android:text="Contraseña" />

    <EditText
        android:id="@+id/txtPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:layout_marginLeft="250px"
        android:layout_marginRight="250px"
        android:layout_marginBottom="70px"
        android:textSize="24sp"
        android:inputType="textPassword" />

    <TextView android:id="@+id/lblVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:fontFamily="sans-serif-smallcaps"
        android:layout_centerInParent="true"
        android:textSize="24sp"
        android:textColor="#FFF"
        android:text="" />

    <TextView android:id="@+id/lblRevision"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:fontFamily="sans-serif-smallcaps"
        android:layout_centerInParent="true"
        android:textSize="24sp"
        android:textColor="#FFF"
        android:text="" />

    <TextView android:id="@+id/lblWifi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:fontFamily="sans-serif-smallcaps"
        android:layout_centerInParent="true"
        android:textSize="24sp"
        android:textColor="#FFF"
        android:text="" />

    <TextView android:id="@+id/lblDataMobile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:fontFamily="sans-serif-smallcaps"
        android:layout_centerInParent="true"
        android:textSize="24sp"
        android:textColor="#FFF"
        android:text="" />

    <TextView android:id="@+id/lblBlueTooth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:fontFamily="sans-serif-smallcaps"
        android:layout_centerInParent="true"
        android:textSize="24sp"
        android:textColor="#FFF"
        android:text="" />


    <LinearLayout
              android:layout_width="fill_parent"
              android:layout_height="fill_parent"
              android:layout_gravity="right"
              android:layout_marginTop="25px"
              android:orientation="horizontal" >

        <ImageButton android:layout_height="fill_parent" android:id="@+id/btnAccept"
        android:textColor="#FFF" android:background="#FFF"
        android:text="Entrar" android:layout_weight=".50" android:src="@drawable/ic_access"
        android:layout_width="0dip" android:onClick="OnAcceptClick" />

        <ImageButton android:layout_height="fill_parent" android:id="@+id/btnCancel"
        android:textColor="#FFF" android:background="#FFF"
        android:text="Salit" android:layout_weight=".50" android:src="@drawable/ic_close"
        android:layout_width="0dip" android:onClick="OnCancelClick" />

	 </LinearLayout>

     <TextView android:id="@+id/lblSpaces"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginLeft="50px"
        	  android:layout_marginRight="50px"
              android:text="      " />

</LinearLayout>
