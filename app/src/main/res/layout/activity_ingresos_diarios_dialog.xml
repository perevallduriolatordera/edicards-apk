<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="20dp">

    <!-- Título -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingreso Diario"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#0277BD"
        android:gravity="center"
        android:paddingBottom="16dp"/>

    <!-- Mensaje de aviso -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF3E0"
        android:padding="16dp"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical">

        <!-- Icono de advertencia (usando un TextView con símbolo) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠"
            android:textSize="28sp"
            android:textColor="#FF6F00"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Es obligatorio tomar foto del comprobante de ingreso"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#E65100"/>
    </LinearLayout>

    <!-- Contenedor de la foto -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F5F5F5"
        android:padding="16dp"
        android:gravity="center"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vista Previa del Comprobante"
            android:textSize="14sp"
            android:textColor="#757575"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <!-- ImageView para la foto -->
        <ImageView
            android:id="@+id/imgPhoto"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:scaleType="centerCrop"
            android:background="#E0E0E0"
            android:contentDescription="Vista previa de la foto del comprobante"/>
    </LinearLayout>

    <!-- Espaciador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Botones de acción -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Botón Tomar Foto -->
        <net.ifeu.library.Controls.ButtonColor
            android:id="@+id/btnTakePhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:layout_marginBottom="12dp"
            android:background="#4CAF50"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="📷  Tomar Foto del Comprobante"/>

        <!-- Botón Cerrar -->
        <net.ifeu.library.Controls.ButtonColor
            android:id="@+id/btnClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:background="#757575"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:text="Cerrar"/>
    </LinearLayout>

</LinearLayout>
