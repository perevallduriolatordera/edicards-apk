<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Edicards">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="20px"
            android:layout_marginRight="20px"
            android:orientation="horizontal" >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Es obligatorio tomar fotos del DNI por ambos lados!"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:textColor="@color/WhiteSmoke"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal" >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical" >

                <ImageView
                    android:id="@+id/imgFrontPhoto"
                    android:layout_width="400dp"
                    android:layout_height="200dp"></ImageView>

                <net.ifeu.library.Controls.ButtonColor
                    android:id="@+id/btnTakeFrontPhoto"
                    android:padding="10dp"
                    android:layout_marginLeft="20px"
                    android:layout_marginRight="20px"
                    android:layout_width="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_button"
                    android:textColor="@color/Black"
                    android:layout_gravity="center"
                    android:text="Tomar foto anverso"/>

                <net.ifeu.library.Controls.ButtonColor
                    android:id="@+id/btnClose"
                    android:padding="10dp"
                    android:layout_marginLeft="20px"
                    android:layout_marginRight="20px"
                    android:layout_width="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_button"
                    android:textColor="@color/Black"
                    android:layout_gravity="center"
                    android:text="Cerrar Pantalla"/>
            </LinearLayout>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical" >

                <ImageView
                    android:id="@+id/imgBackPhoto"
                    android:layout_width="400dp"
                    android:layout_height="200dp"></ImageView>

                <net.ifeu.library.Controls.ButtonColor
                    android:id="@+id/btnTakeBackPhoto"
                    android:padding="10dp"
                    android:layout_marginLeft="20px"
                    android:layout_marginRight="20px"
                    android:layout_width="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_button"
                    android:layout_gravity="center"
                    android:textColor="@color/Black"
                    android:text="Tomar foto reverso"/>
            </LinearLayout>
        </LinearLayout>
</LinearLayout>