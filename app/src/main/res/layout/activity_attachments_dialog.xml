<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Header moderno -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#2196F3"
        android:padding="16dp"
        android:elevation="4dp"
        android:gravity="center">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Documentación del Cliente"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fotografía del DNI (ambos lados)"
            android:textSize="14sp"
            android:textColor="#E3F2FD"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Mensaje de advertencia -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF3E0"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠"
            android:textSize="28sp"
            android:textColor="#FF6F00"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Es obligatorio tomar fotos del DNI por ambos lados"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#E65100"/>
    </LinearLayout>

    <!-- Contenedor principal con scroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center">

            <!-- Columna Anverso (izquierda) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ANVERSO"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2196F3"
                    android:gravity="center"
                    android:layout_marginBottom="12dp"/>

                <!-- Tarjeta para foto anverso -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#F5F5F5"
                    android:padding="12dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/imgFrontPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:scaleType="centerCrop"
                        android:background="#E0E0E0"
                        android:contentDescription="Foto anverso del DNI"/>
                </LinearLayout>

                <net.ifeu.library.Controls.ButtonColor
                    android:id="@+id/btnTakeFrontPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📷 Tomar Foto Anverso"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#4CAF50"
                    android:padding="14dp"
                    android:elevation="2dp"/>
            </LinearLayout>

            <!-- Columna Reverso (derecha) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="REVERSO"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2196F3"
                    android:gravity="center"
                    android:layout_marginBottom="12dp"/>

                <!-- Tarjeta para foto reverso -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#F5F5F5"
                    android:padding="12dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/imgBackPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:scaleType="centerCrop"
                        android:background="#E0E0E0"
                        android:contentDescription="Foto reverso del DNI"/>
                </LinearLayout>

                <net.ifeu.library.Controls.ButtonColor
                    android:id="@+id/btnTakeBackPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📷 Tomar Foto Reverso"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#4CAF50"
                    android:padding="14dp"
                    android:elevation="2dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Botón cerrar fijo en la parte inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <net.ifeu.library.Controls.ButtonColor
            android:id="@+id/btnClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cerrar"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="#757575"
            android:padding="14dp"
            android:elevation="2dp"/>
    </LinearLayout>

</LinearLayout>
