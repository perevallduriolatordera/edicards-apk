<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayoutLogBookPreview"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    android:background="@color/Edicards">

    <TextView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="Vista previa de trazabilidad"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="10dp"
        android:background="@color/DarkBlue"
        android:textColor="@color/White" />

    <LinearLayout
        android:id="@+id/buttonLinearLayout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:background="@color/WhiteSmoke"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="10dp">
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:scrollbars="horizontal"
        android:fillViewport="false">

        <LinearLayout
            android:id="@+id/headerMainLinearLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@color/DarkBlue"
            android:orientation="horizontal"
            android:padding="5dp">

            <TextView
                android:text="ID"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:gravity="center"
                android:padding="5dp" />

            <TextView
                android:text="Fecha"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:gravity="center"
                android:padding="5dp" />

            <TextView
                android:text="Cód. Cliente"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:gravity="center"
                android:padding="5dp" />

            <TextView
                android:text="Nombre Cliente"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:gravity="center"
                android:padding="5dp" />

            <TextView
                android:text="Cód. Artículo"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:gravity="center"
                android:padding="5dp" />

            <TextView
                android:text="Nombre Artículo"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:gravity="center"
                android:padding="5dp" />

            <TextView
                android:text="Tipo Mov."
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:gravity="center"
                android:padding="5dp" />

            <TextView
                android:text="Dep. Inicial"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:gravity="center"
                android:padding="5dp" />

            <TextView
                android:text="Dep. Final"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:gravity="center"
                android:padding="5dp" />

            <TextView
                android:text="Unid. Cont."
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:gravity="center"
                android:padding="5dp" />

            <TextView
                android:text="Unid. Fact."
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:gravity="center"
                android:padding="5dp" />

            <TextView
                android:text="Unid. Abon."
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:gravity="center"
                android:padding="5dp" />

            <TextView
                android:text="Stock Inicial"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:gravity="center"
                android:padding="5dp" />

            <TextView
                android:text="Stock Final"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:gravity="center"
                android:padding="5dp" />

        </LinearLayout>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:scrollbars="horizontal"
        android:fillViewport="false"
        android:background="@color/White">

        <ListView
            android:id="@+id/logbookListView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:divider="#b5b5b5"
            android:dividerHeight="1dp" />
    </HorizontalScrollView>

</LinearLayout>
