<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    android:background="@color/Edicards" >

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="15dp"
        android:src="@drawable/edicards_logo_bitmap"
        android:layout_gravity="center"
        android:layout_marginTop="10px"
        android:layout_marginBottom="10px"/>

    <TextView
        android:id="@+id/lblUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:textColor="#FFF"
        android:text="Identificador del usuario" />

    <EditText
        android:id="@+id/txtUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:ems="10" >

        <requestFocus />
    </EditText>

    <TextView
        android:id="@+id/lblPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:textColor="#FFF"
        android:text="Contraseña" />

    <EditText
        android:id="@+id/txtPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:ems="10"
        android:inputType="textPassword" />

    <TextView
        android:id="@+id/lblPasswordRepeat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:textColor="#FFF"
        android:text="Vuelva a escribir la contraseña" />

    <EditText
        android:id="@+id/txtPasswordRepeat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:ems="10"
        android:inputType="textPassword" />

    <TextView
        android:id="@+id/lblSerialInvoiceA"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:textColor="#FFF"
        android:text="Código Série Factura A" />

    <EditText
        android:id="@+id/txtSerialInoviceA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:ems="10" >
    </EditText>

    <TextView
        android:id="@+id/lblSerialInoviceB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:textColor="#FFF"
        android:text="Código Série Factura B" />

    <EditText
        android:id="@+id/txtSerialInoviceB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:ems="10" >
    </EditText>

    <TextView
        android:id="@+id/lblCompany"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:textColor="#FFF"
        android:text="Código de Empresa" />

    <EditText
        android:id="@+id/txtCompany"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:ems="10" >
    </EditText>

    <TextView
        android:id="@+id/lblName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:textColor="#FFF"
        android:text="Nombre del vendedor" />

    <EditText
        android:id="@+id/txtName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:ems="10" >
    </EditText>

    <TextView
        android:id="@+id/lblSerieA"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:textColor="#FFF"
        android:text="Inicialización Serie A" />

    <EditText
        android:id="@+id/txtSerieA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:ems="10" >
    </EditText>

     <TextView
        android:id="@+id/lblSerieB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:textColor="#FFF"
        android:text="Inicialización Serie B" />

    <EditText
        android:id="@+id/txtSerieB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:ems="10" >
    </EditText>

    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_gravity="right"
        android:layout_marginTop="5px"
        android:orientation="horizontal" >

        <ImageButton
            android:id="@+id/btnAccept"
            android:layout_width="0dip"
            android:layout_height="fill_parent"
            android:layout_weight=".50"
            android:background="#FFF"
            android:onClick="OnAcceptClick"
            android:src="@drawable/ic_new_customer"
            android:text="Entrar"
            android:textColor="#FFF" />

        <ImageButton
            android:id="@+id/btnCancel"
            android:layout_width="0dip"
            android:layout_height="fill_parent"
            android:layout_weight=".50"
            android:background="#FFF"
            android:onClick="OnCancelClick"
            android:src="@drawable/ic_close"
            android:text="Salir"
            android:textColor="#FFF" />
    </LinearLayout>

</LinearLayout>