<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#E3F2FD"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="center">

        <TextView
            android:id="@+id/lblTituloRutas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ruta Optimizada de Clientes"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <View
            android:layout_width="80dp"
            android:layout_height="2dp"
            android:background="#1976D2"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/lblFechaGeneracion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Generada: --/--/----"
                android:textSize="14sp"
                android:textColor="#424242"/>

            <TextView
                android:id="@+id/lblTotalClientes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total clientes: 0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1976D2"/>
        </LinearLayout>
    </LinearLayout>

    <ListView
        android:id="@+id/listViewRutas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#E0E0E0"
        android:dividerHeight="1dp"
        android:background="#FFFFFF"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnRegenerarRuta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Regenerar Ruta"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#1976D2"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnLimpiarCoordenadas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Limpiar Coordenadas (Debug)"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textSize="12sp"
            android:background="#FF9800"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</LinearLayout>
