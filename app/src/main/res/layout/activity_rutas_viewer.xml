<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/headerRuta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#E3F2FD"
        android:padding="6dp"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/lblTituloRutas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ruta Optimizada de Clientes 🔄"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:gravity="center"
            android:layout_marginBottom="2dp"/>

        <View
            android:layout_width="50dp"
            android:layout_height="2dp"
            android:background="#1976D2"
            android:layout_marginBottom="3dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/lblFechaGeneracion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Generada: --/--/----"
                android:textSize="11sp"
                android:textColor="#424242"/>

            <TextView
                android:id="@+id/lblTotalClientes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total clientes: 0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#1976D2"/>
        </LinearLayout>

        <!-- Botón para ocultar/mostrar controles -->
        <Button
            android:id="@+id/btnToggleControles"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:text="▼ Ocultar controles"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="#90CAF9"
            android:textColor="#1565C0"
            android:layout_marginTop="3dp"
            android:padding="0dp"/>
    </LinearLayout>

    <!-- Contenedor de todos los controles (ocultable) -->
    <LinearLayout
        android:id="@+id/contenedorControles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TODO EN UNA SOLA FILA HORIZONTAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:background="#E3F2FD"
            android:padding="6dp"
            android:gravity="center_vertical">

            <!-- Ordenar Por -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ord:"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:layout_marginEnd="6dp"/>

            <Spinner
                android:id="@+id/spinnerOrdenacion"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:background="@android:drawable/btn_dropdown"
                android:padding="2dp"
                android:layout_marginEnd="12dp"/>

            <!-- Buscador -->
            <EditText
                android:id="@+id/txtBuscador"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:hint="Buscar..."
                android:textSize="11sp"
                android:textColor="#000000"
                android:textColorHint="#9E9E9E"
                android:padding="4dp"
                android:background="@android:color/white"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:layout_marginEnd="8dp"/>

            <!-- Botón Limpiar -->
            <Button
                android:id="@+id/btnLimpiarBusqueda"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="✕"
                android:textSize="14sp"
                android:background="#FF9800"
                android:textColor="@android:color/white"
                android:layout_marginEnd="8dp"
                android:padding="0dp"
                android:contentDescription="Limpiar búsqueda"/>

            <!-- Filtro Favoritos -->
            <Button
                android:id="@+id/btnFiltroFavoritos"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="☆"
                android:textSize="16sp"
                android:background="#FFFFFF"
                android:textColor="#9E9E9E"
                android:padding="0dp"
                android:layout_marginEnd="14dp"
                android:contentDescription="Filtrar favoritos"/>

            <!-- Botones de acción con iconos y leyendas -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="10dp">
                <Button
                    android:id="@+id/btnRegenerarRuta"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:text="🔄"
                    android:textSize="16sp"
                    android:background="#1976D2"
                    android:textColor="#FFFFFF"
                    android:padding="0dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Regen"
                    android:textSize="7sp"
                    android:textColor="#1976D2"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="10dp">
                <Button
                    android:id="@+id/btnExportarExcel"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:text="📊"
                    android:textSize="16sp"
                    android:background="#4CAF50"
                    android:textColor="#FFFFFF"
                    android:padding="0dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Excel"
                    android:textSize="7sp"
                    android:textColor="#4CAF50"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="10dp">
                <Button
                    android:id="@+id/btnGestionarZonas"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:text="🗺️"
                    android:textSize="16sp"
                    android:background="#9C27B0"
                    android:textColor="#FFFFFF"
                    android:padding="0dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zonas"
                    android:textSize="7sp"
                    android:textColor="#9C27B0"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="10dp">
                <Button
                    android:id="@+id/btnToggleMapa"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:text="🗺️"
                    android:textSize="16sp"
                    android:background="#2196F3"
                    android:textColor="#FFFFFF"
                    android:padding="0dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mapa"
                    android:textSize="7sp"
                    android:textColor="#2196F3"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="10dp">
                <Button
                    android:id="@+id/btnCiudadBase"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:text="🏠"
                    android:textSize="16sp"
                    android:background="#795548"
                    android:textColor="#FFFFFF"
                    android:padding="0dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Base"
                    android:textSize="7sp"
                    android:textColor="#795548"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="10dp">
                <Button
                    android:id="@+id/btnLimpiarCoordenadas"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:text="🗑️"
                    android:textSize="16sp"
                    android:background="#FF9800"
                    android:textColor="#FFFFFF"
                    android:padding="0dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Limp"
                    android:textSize="7sp"
                    android:textColor="#FF9800"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <Button
                    android:id="@+id/btnEstadoClientes"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:text="ℹ️"
                    android:textSize="16sp"
                    android:background="#00BCD4"
                    android:textColor="#FFFFFF"
                    android:padding="0dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Info"
                    android:textSize="7sp"
                    android:textColor="#00BCD4"
                    android:gravity="center"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Contenedor del Mapa (inicialmente oculto) -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <fragment
            android:id="@+id/mapFragment"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>

    <!-- ListView de Rutas (visible por defecto) -->
    <ListView
        android:id="@+id/listViewRutas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#E0E0E0"
        android:dividerHeight="1dp"
        android:background="#FFFFFF"/>

</LinearLayout>
