<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/linearLayout1"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layout_alignParentTop="true"
    android:layout_marginTop="30dp"
    android:orientation="vertical" >

    <EditText
        android:id="@+id/txtTextSearch"
        android:layout_width="800px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:ems="16"
        android:hint="cliente a buscar" >
    </EditText>

    <CheckBox
        android:id="@+id/chkOnlyStartsWith"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:layout_marginTop="15dp"
        android:checked="false"
        android:text="Empiezan por" />

    <RadioGroup
        android:id="@+id/grpFilterField"
        android:layout_width="800px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:layout_marginTop="14dp"
        android:background="@drawable/border"
        android:orientation="horizontal"
        android:text="Buscar por el campo..." >

        <RadioButton
            android:id="@+id/optNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginRight="14dp"
            android:text="Nombre" />

        <RadioButton
            android:id="@+id/optNIF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginBottom="20dp"
            android:layout_marginRight="14dp"
            android:text="NIF" />

        <RadioButton
            android:id="@+id/optTelefono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginBottom="20dp"
            android:layout_marginRight="14dp"
            android:text="Telefono" />

        <RadioButton
            android:id="@+id/optPoblacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginBottom="20dp"
            android:layout_marginRight="14dp"
            android:text="Población" />
    </RadioGroup>

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_alignParentTop="true"
        android:layout_marginTop="30dp"
        android:orientation="horizontal" >

        <Button
            android:id="@+id/btnAccept"
            android:layout_width="150px"
            android:layout_marginLeft="25px"
            android:layout_marginRight="25px"
            android:layout_marginTop="20dp"
            android:background="#FFF"
            android:text="Buscar"
            android:textColor="#000" />

        <Button
            android:id="@+id/btnNewCustomer"
            android:layout_width="150px"
            android:layout_marginLeft="25px"
            android:layout_marginRight="25px"
            android:layout_marginTop="20dp"
            android:background="#FFF"
            android:text="Nuevo cliente"
            android:textColor="#000" />
        
        <Button
            android:id="@+id/btnClose"
            android:layout_width="150px"
            android:layout_marginLeft="25px"
            android:layout_marginRight="25px"
            android:layout_marginTop="20dp"
            android:background="#FFF"
            android:text="Cerrar"
            android:textColor="#000" />
    </LinearLayout>

</LinearLayout>