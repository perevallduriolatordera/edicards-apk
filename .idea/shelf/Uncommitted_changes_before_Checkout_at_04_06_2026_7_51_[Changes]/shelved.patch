+	public void InputBoxAsync(String title, String text, Context context, InputBoxCallback callback)
+	{
+		final TextBoxColor textBox = new TextBoxColor(context, Color.BLACK);
+
+		new AlertDialog.Builder(new ContextThemeWrapper(context, R.style.AppTheme))
+	    .setTitle(title)
+	    .setMessage(text)
+	    .setView(textBox)
+	    .setCancelable(false)
+	    .setPositiveButton("Aceptar", (dialog, whichButton) -> {
+			Editable value = textBox.getText();
+			callback.onResult(value.toString());
+			dialog.dismiss();
+		}).setNegativeButton("Cancelar", (dialog, whichButton) -> {
+			callback.onResult(ConstantsTypes.EMPTY_STRING);
+			dialog.dismiss();
+		}).create().show();
+	}
+
+	// Interfaz callback para manejo asincrónico de InputBox
+	public interface InputBoxCallback {
+		void onResult(String value);
+	}
